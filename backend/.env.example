# ============================================================
# 实验室化学试剂仓库管理系统 — 后端环境变量
# ============================================================
# 复制此文件为 .env 并填写实际值。
# 生产环境切勿将 .env 提交到 Git。

# --- 项目基础信息 ---
PROJECT_NAME=实验室化学试剂仓库管理系统
VERSION=0.1.0

# --- 运行环境 ---
# development = 本地开发（CORS 全开、DEBUG 可用、允许默认 superadmin）
# production  = 生产部署（CORS 必须指定域名、禁止弱密码、强制强密钥）
ENVIRONMENT=development

# --- 数据库 ---
# 本地 SQLite（开发）：
#   DATABASE_URL=sqlite:///./lab_reagent.db
# Supabase PostgreSQL（生产）：
#   DATABASE_URL=postgresql+psycopg2://postgres.xxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./lab_reagent.db

# --- 安全 ---
# 生产环境必须替换为随机强密钥（可用 openssl rand -hex 32 生成）
SECRET_KEY=replace-with-a-strong-secret-key
# JWT 过期时间（分钟），建议生产环境 480（8 小时）
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 生产环境必须设置为 false
DEBUG=false

# --- CORS ---
# 生产环境填写前端实际域名，多个逗号分隔
# 例如：https://your-app.pages.dev
# 开发环境使用 * 允许所有来源
CORS_ORIGINS=*

# --- 前端地址（用于文档或重定向参考）---
FRONTEND_URL=http://127.0.0.1:5173

# --- 默认超级管理员（仅首次部署使用）---
# 本地开发可跳过，脚本使用内置默认值
# 生产环境必须通过以下三个变量提供自定义用户名和强密码：
DEFAULT_SUPERADMIN_USERNAME=
DEFAULT_SUPERADMIN_PASSWORD=
# 生产环境必须为 true 才允许创建 superadmin
ALLOW_DEFAULT_SUPERADMIN=false

# --- 本地同步与 Mock 开关 ---
SYNC_MOCK_ENABLED=true

# --- 腾讯文档真实同步配置 ---
TENCENT_DOCS_MODE=real
TENCENT_DOCS_CLIENT_ID=

# 模式 A：OAuth 授权模式。只有需要后端发起 OAuth 授权时才填写以下两项。
TENCENT_DOCS_CLIENT_SECRET=
TENCENT_DOCS_REDIRECT_URI=

# 模式 B：Direct Token 模式。腾讯文档开放生态后台如果只提供 client_id、access_token、open_id，
# 请填写 ACCESS_TOKEN 和 OPEN_ID；access_token 不是 client_secret，不要填到 CLIENT_SECRET。
TENCENT_DOCS_ACCESS_TOKEN=
TENCENT_DOCS_OPEN_ID=

TENCENT_DOCS_ENCODED_ID=
# Official fileID returned by converter. If empty, backend can resolve it from ENCODED_ID.
TENCENT_DOCS_FILE_ID=
# Optional. If empty, backend uses resolved official fileID as sheetbook bookID.
TENCENT_DOCS_BOOK_ID=
# Legacy/debug only: fixed sheetID for debug/testing. Formal import/export auto-resolves
# sheetID by matching sheet titles to year/month (e.g. "2026.5" → sheetID "000005").
TENCENT_DOCS_SHEET_ID=
TENCENT_DOCS_SHEET_TITLE=
TENCENT_DOCS_TAB_ID=
# Optional JSON map for explicit year.month → sheetID mapping, e.g. {"2026.5":"000005"}
TENCENT_DOCS_SHEET_MAP_JSON=
# Sheet title pattern used when matching: {year}.{month}, {year}.{month:02d}, etc.
TENCENT_DOCS_SHEET_TITLE_PATTERN={year}.{month}
# OpenAPI 基础域名。不要填写网页 URL；写回使用官方路径：
# PUT /openapi/sheetbook/v2/{bookID}/values/{range}
TENCENT_DOCS_API_BASE_URL=https://docs.qq.com
# Read/write endpoints are built into backend:
#   GET /openapi/spreadsheet/v3/files/{fileId}/{sheetId}/{range}
#   PUT /openapi/sheetbook/v2/{bookID}/values/{sheetId}!{range}
# Keep these legacy endpoint variables empty unless code is explicitly extended later.
TENCENT_DOCS_SHEET_READ_ENDPOINT=
TENCENT_DOCS_SHEET_WRITE_ENDPOINT=
TENCENT_DOCS_SHEET_RANGE=A1:BF37
TENCENT_DOCS_READ_RANGE=A1:BF37
TENCENT_DOCS_WRITE_RANGE=B4:BF34

# 指定腾讯文档同步使用”试剂矩阵模板”解析/写回逻辑
TENCENT_DOCS_TEMPLATE_TYPE=reagent_matrix

# Legacy/debug only: active month for debug probes. Formal import/export uses
# the month selected in the frontend modal, not this fixed value.
TENCENT_DOCS_ACTIVE_MONTH=1
TENCENT_DOCS_DEFAULT_YEAR=2026
# Direct Token 过期时间仅用于前端提醒；前端保存到数据库后优先生效，不会写回 .env。
TENCENT_DOCS_TOKEN_EXPIRES_AT=
# Write-Cell 测试固定写第一个 sheet 左上角 A1，便于人工确认连通性。
TENCENT_DOCS_WRITE_CELL_TEST_SHEET_ID=000001
TENCENT_DOCS_WRITE_CELL_TEST_RANGE=A1:A1

# --- 旧版腾讯文档兼容字段 ---
TENCENT_DOC_CLIENT_ID=
TENCENT_DOC_CLIENT_SECRET=
TENCENT_DOC_REDIRECT_URI=
TENCENT_DOC_DOC_ID=

# --- 企业微信通知 ---
WECHAT_WORK_WEBHOOK=
